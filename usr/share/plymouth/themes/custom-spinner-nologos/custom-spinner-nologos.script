Window.SetBackgroundTopColor(0.188, 0.188, 0.188);  // #303030 in RGB
Window.SetBackgroundBottomColor(0.188, 0.188, 0.188);

// Create and animate spinner
spinner_image = Image("throbber-0001.png");
spinner_sprite = Sprite(spinner_image);
spinner_sprite.SetX(Window.GetWidth() / 2 - spinner_image.GetWidth() / 2);
spinner_sprite.SetY(Window.GetHeight() / 2 - spinner_image.GetHeight() / 2);

anim_counter = 1;
anim_total_frames = 30;
anim_status = "forward";

fun refresh_callback ()
{
  if (anim_status == "forward")
    {
      anim_counter++;
      if (anim_counter > anim_total_frames)
        anim_counter = 1;
    }
  else if (anim_status == "backward")
    {
      anim_counter--;
      if (anim_counter < 1)
        anim_counter = anim_total_frames;
    }

  frame_number = anim_counter;
  if (frame_number < 10)
    frame_number = "0" + frame_number;
  
  spinner_image = Image("throbber-00" + frame_number + ".png");
  spinner_sprite.SetImage(spinner_image);
  spinner_sprite.SetX(Window.GetWidth() / 2 - spinner_image.GetWidth() / 2);
  spinner_sprite.SetY(Window.GetHeight() / 2 - spinner_image.GetHeight() / 2);
}

Plymouth.SetRefreshFunction(refresh_callback);

// Add your custom logo to the top center
if (Plymouth.GetMode() == "boot")
{
  logo.image = Image("logo-login.png");
  logo.sprite = Sprite(logo.image);
  logo.sprite.SetX(Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
  logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() - 50);
}

// Display message function
message_sprite = Sprite();
message_sprite.SetPosition(Window.GetWidth() / 2, Window.GetHeight() - 20, 10000);

fun display_message_callback (text)
{
  my_image = Image.Text(text, 1, 1, 1);
  message_sprite.SetImage(my_image);
  message_sprite.SetX(Window.GetWidth() / 2 - my_image.GetWidth() / 2);
}

Plymouth.SetDisplayMessageFunction(display_message_callback);
// Dynamic message based on operation mode
fun update_operation_message () {
    if (Plymouth.GetMode() == "boot") {
        display_message_callback("Booting system...");
    } else if (Plymouth.GetMode() == "shutdown") {
        display_message_callback("Shutting down...");
    } else if (Plymouth.GetMode() == "reboot") {
        display_message_callback("Restarting system...");
    } else {
        display_message_callback("Please wait...");
    }
}

Plymouth.SetBootProgressFunction(update_operation_message);
Plymouth.SetShutdownProgressFunction(update_operation_message);
Plymouth.SetRebootProgressFunction(update_operation_message);
update_operation_message();
