#!/bin/bash
# FINAL FAIL-SAFE RDP CLIENT - UPN BYPASS VERSION
# This script is executed by LightDM for rdpuser

LOG_FILE="/tmp/rdp-run.log"
echo "$(date): Skript gestartet" > $LOG_FILE

# CONFIGURATION LOADING
CONFIG_FILE="/etc/rdp-client/config"
if [ -f "$CONFIG_FILE" ]; then
    source "$CONFIG_FILE"
fi

# Check if we have a valid server or if we should open settings
if [ -z "$SERVER" ] || [ "$SERVER" == "rdp-server-ip" ] || [ "$SERVER" == "your.server.ip" ]; then
    echo "$(date): No valid server found, launching settings UI" >> $LOG_FILE
    /usr/local/bin/rdp-settings
    # Re-source after settings might have changed
    [ -f "$CONFIG_FILE" ] && source "$CONFIG_FILE"
fi

export DISPLAY=:0
export XAUTHORITY=/home/rdpuser/.Xauthority
xhost +local:all >> $LOG_FILE 2>&1

# Warten auf X-Server
while ! xset q &>/dev/null; do
    echo "$(date): Warten auf X-Server..." >> $LOG_FILE
    sleep 1
done

# RDP Befehl zusammenbauen (UPN Bypass Konfiguration)
# Note: If USERNAME already contains @, we use it as is.
RDP_OPTS="/v:$SERVER /u:$USERNAME /p:$PASSWORD /sec:rdp -sec-tls -sec-nla -gfx -rfx /gdi:sw /size:3840x1080 /f -dynamic-resolution /bpp:16 -bitmap-cache -glyph-cache -offscreen-cache -themes -wallpaper -aero +fonts +clipboard /usb:auto /cert-ignore /cert:ignore /cert-tofu /auto-reconnect /auto-reconnect-max-retries:20"

# Detect xfreerdp binary (Debian 12 vs 13)
if command -v xfreerdp3 &>/dev/null; then
    XFREERDP_BIN="xfreerdp3"
elif command -v xfreerdp &>/dev/null; then
    XFREERDP_BIN="xfreerdp"
else
    echo "$(date): Error: Neither xfreerdp3 nor xfreerdp found" >> $LOG_FILE
    exit 1
fi

RDP_CMD="$XFREERDP_BIN $RDP_OPTS"

echo "$(date): Starte Befehl mit $XFREERDP_BIN: $XFREERDP_BIN /v:$SERVER /u:$USERNAME ..." >> $LOG_FILE

while true; do
    # Kill any stray processes
    pkill -9 xfreerdp
    pkill -9 xfreerdp3
    
    # Execute
    $RDP_CMD >> $LOG_FILE 2>&1
    EXIT_CODE=$?
    echo "$(date): xfreerdp beendet mit Code $EXIT_CODE" >> $LOG_FILE
    
    sleep 5
done
