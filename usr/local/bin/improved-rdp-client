#!/bin/bash
# FINAL FAIL-SAFE RDP CLIENT - UPN BYPASS VERSION
# This script is executed by LightDM for rdpuser

LOG_FILE="/tmp/rdp-run.log"
echo "$(date): Skript gestartet" > $LOG_FILE

export DISPLAY=:0
export XAUTHORITY=/home/rdpuser/.Xauthority

# CONFIGURATION LOADING
CONFIG_FILE="/etc/rdp-client/config"
if [ -f "$CONFIG_FILE" ]; then
    source "$CONFIG_FILE"
fi
# Warten auf X-Server
while ! xset q &>/dev/null; do
    echo "$(date): Warten auf X-Server..." >> $LOG_FILE
    sleep 1
done

# Check if we have a valid server or if we should open settings
if [[ -z "$SERVER" || "$SERVER" == *"your"* || "$SERVER" == *"rdp-server"* ]]; then
    echo "$(date): Placeholder config detected, launching settings UI..." >> $LOG_FILE
    /usr/local/bin/rdp-settings >> $LOG_FILE 2>&1
    # Re-source after settings might have changed
    [ -f "$CONFIG_FILE" ] && source "$CONFIG_FILE"
fi

xhost +local:all >> $LOG_FILE 2>&1

# RDP Befehl zusammenbauen (FreeRDP 3 syntax)
# Refactored for FreeRDP 3 as per help output
RDP_OPTS="/v:$SERVER /u:$USERNAME /p:$PASSWORD /f /dynamic-resolution /bpp:16 /audio-mode:0 /network:lan /gfx:progressive /gdi:sw +fonts +clipboard /usb:auto /cert:ignore /auto-reconnect /auto-reconnect-max-retries:20"

# FreeRDP 3 Cache and Security settings
RDP_OPTS="$RDP_OPTS /cache:bitmap,glyph,offscreen /sec:nla"

if [ ! -z "$DOMAIN" ] && [ "$DOMAIN" != "YOURDOMAIN" ]; then
    RDP_OPTS="/d:$DOMAIN $RDP_OPTS"
fi

# Detect xfreerdp binary (Debian 12 vs 13)
if command -v xfreerdp3 &>/dev/null; then
    XFREERDP_BIN="xfreerdp3"
elif command -v xfreerdp &>/dev/null; then
    XFREERDP_BIN="xfreerdp"
else
    echo "$(date): Error: Neither xfreerdp3 nor xfreerdp found" >> $LOG_FILE
    exit 1
fi

RDP_CMD="$XFREERDP_BIN $RDP_OPTS"

echo "$(date): Starte Befehl: $RDP_CMD" >> $LOG_FILE

while true; do
    # Kill any stray processes
    pkill -9 xfreerdp
    pkill -9 xfreerdp3
    
    # Execute
    $RDP_CMD >> $LOG_FILE 2>&1
    EXIT_CODE=$?
    echo "$(date): $XFREERDP_BIN beendet mit Code $EXIT_CODE" >> $LOG_FILE
    
    # If the user exited normally or there's a serious error, maybe show settings
    if [ $EXIT_CODE -ne 0 ]; then
         sleep 2
    fi
    sleep 3
done
