#!/bin/bash

# This script sets up the display for the RDP client

# Set up environment
export DISPLAY=:0
export XAUTHORITY=/home/rdpuser/.Xauthority

# Set background color to match branding (Neutral Gray)
xsetroot -solid "#333333"

# Force standard cursor (remove the big X)
xsetroot -cursor_name left_ptr
export XCURSOR_THEME=Adwaita
export XCURSOR_SIZE=24

# Create desktop directory and add RDP settings shortcut
mkdir -p /home/rdpuser/Desktop
cp /usr/share/applications/rdp-settings.desktop /home/rdpuser/Desktop/
chown -R rdpuser:rdpuser /home/rdpuser/Desktop

# Fix permissions for config files
mkdir -p /etc/rdp-client
chown -R rdpuser:rdpuser /etc/rdp-client
chmod 755 /etc/rdp-client

# Start the RDP client


exit 0
