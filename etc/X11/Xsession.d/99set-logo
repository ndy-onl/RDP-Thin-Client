#!/bin/sh
LOGO_PATH="/usr/local/share/branding/logo-login.png"

# Ensure feh is installed
if ! command -v feh &>/dev/null; then
    apt-get update && apt-get install -y feh
fi

# Position logo in the bottom-right corner
# Use -g (geometry) with offset from bottom-right (+)
feh --bg-center --geometry +20+20 "$LOGO_PATH"
# Wait, for bottom right in X11 geometry usually -20-20
feh --bg-center --no-xinerama --geometry -40-40 "$LOGO_PATH"
