#!/bin/sh
LOGO_PATH="/usr/local/share/branding/logo-login.png"

# Ensure feh is installed
if ! command -v feh &>/dev/null; then
    apt-get update && apt-get install -y feh
fi

# Position logo in the TOP-RIGHT corner
# -40px from right, +40px from top
# We first set the background color, then the logo
feh --bg-fill "#333333" --bg-center --no-xinerama --geometry -40+40 "$LOGO_PATH"
